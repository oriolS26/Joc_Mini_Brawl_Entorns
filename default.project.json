{
  "name": "Joc_Mini_Brawl",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
        "$path": "src/server"
    },

    "StarterGui": {
      "MainMenu": {
        "$className": "ScreenGui",
        "Frame": {
          "$className": "Frame",
          "MenuScript": {
            "$path": "src/client/MenuScript.client.luau"
          }
        }
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "CameraScript": {
          "$path": "src/client/CameraScript.client.luau"
        }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [512, 20, 512],
          "Position": [0, -10, 0]
        }
      }
    }
  }
}